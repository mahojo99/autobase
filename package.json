{
  "name": "autobase-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "A local conversation with an orchestrator and its bots",
  "author": "Autobase contributors",
  "license": "UNLICENSED",
  "type": "module",
  "main": "dist/main.cjs",
  "engines": {
    "node": ">=24.20.0 <25"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "start": "electron .",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:desktop": "playwright test",
    "test:packaged": "playwright test --config playwright.packaged.config.ts",
    "test:live:delegation": "tsx scripts/live-delegation.ts",
    "test:live": "tsx scripts/live-smoke.ts",
    "package": "node scripts/package.mjs",
    "verify": "npm run typecheck && npm test && npm run build && npm run test:desktop"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.266",
    "lucide-react": "1.43.0",
    "luxon": "3.7.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@electron/packager": "20.3.0",
    "@playwright/test": "1.63.0",
    "@types/luxon": "3.7.5",
    "@types/node": "26.5.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "electron": "44.3.0",
    "esbuild": "0.28.2",
    "prettier": "3.9.6",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vite": "8.2.2"
  }
}
